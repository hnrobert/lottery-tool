# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lottery_system
DB_USER=root
DB_PASSWORD=your_password

# JWT 密钥
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=7d

# 腾讯云 COS 配置（推荐使用环境变量，优先级高于系统设置页的配置）
# 配置后，线下抽奖的签字图片将上传至 COS 存储
COS_SECRET_ID=your_cos_secret_id
COS_SECRET_KEY=your_cos_secret_key
COS_BUCKET=your-bucket-name-1250000000
COS_REGION=ap-guangzhou
# 可选：自定义域名
COS_CUSTOM_DOMAIN=
# 可选：对象前缀
COS_PATH_PREFIX=
